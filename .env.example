# HTTP bind. Default 127.0.0.1 is local-only.
# Render and other hosts inject PORT; bind 0.0.0.0 only with SYNCO_API_KEY set.
HOST=127.0.0.1
PORT=3847

# Required for any non-localhost bind. Sent as: Authorization: Bearer <key>
SYNCO_API_KEY=

# SQLite file. Shared by HTTP and stdio modes.
SYNCO_DATABASE_PATH=./data/synco.sqlite

# Seeded on first boot so the dashboard is never empty.
SYNCO_DEFAULT_PROJECT_ID=default
SYNCO_DEFAULT_PROJECT_NAME=synco-mcp

# Convex HTTP (set on the deployment, not in this file):
#   npx convex env set SYNCO_API_KEY <random>
# Agents call https://<deployment>.convex.site/mcp with Authorization: Bearer <key>.
